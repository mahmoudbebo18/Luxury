/login
  X-Robots-Tag: noindex, nofollow
/register*
  X-Robots-Tag: noindex, nofollow
/forgot
  X-Robots-Tag: noindex, nofollow
/reset
  X-Robots-Tag: noindex, nofollow
/welcome
  X-Robots-Tag: noindex, nofollow
/check-email
  X-Robots-Tag: noindex, nofollow
/join/*
  X-Robots-Tag: noindex, nofollow
/checkout
  X-Robots-Tag: noindex, nofollow
/payment/*
  X-Robots-Tag: noindex, nofollow
/account*
  X-Robots-Tag: noindex, nofollow
/company*
  X-Robots-Tag: noindex, nofollow
/v/*
  X-Robots-Tag: noindex, nofollow
/admin*
